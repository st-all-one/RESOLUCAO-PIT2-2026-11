# Copie para .env e ajuste. NUNCA versione o .env.
APP_ENV=development
APP_SECRET=troque-por-uma-chave-aleatoria-de-32-bytes
APP_BASE_URL=http://127.0.0.1:8000

# MySQL (docker compose expõe 3307 no host)
DATABASE_URL=mysql+pymysql://cupcake:cupcake@127.0.0.1:3307/cupcake?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://cupcake:cupcake@127.0.0.1:3307/cupcake_test?charset=utf8mb4

# Sessão
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE=86400

# Regras de negócio (valores de demonstração)
FRETE_VALOR=8.00
FRETE_GRATIS_ACIMA=120.00
