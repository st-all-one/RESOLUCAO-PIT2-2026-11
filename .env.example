# Copie para .env e ajuste. NUNCA versione o .env.
APP_ENV=development
# Gere com: openssl rand -hex 32 (produção exige >=32 caracteres)
APP_SECRET=dev-insecure-change-me
APP_BASE_URL=http://127.0.0.1:8000

# MariaDB (docker compose expõe 3307 no host)
DATABASE_URL=mariadb+pymysql://cupcake:cupcake@127.0.0.1:3307/cupcake?charset=utf8mb4
TEST_DATABASE_URL=mariadb+pymysql://cupcake:cupcake@127.0.0.1:3307/cupcake_test?charset=utf8mb4

# Stack docker (produção/VPS)
# Troque as duas senhas abaixo em produção.
MARIADB_ROOT_PASSWORD=cupcake_root
MARIADB_PASSWORD=cupcake
# Em produção mantenha 127.0.0.1 e publique via proxy HTTPS.
APP_BIND=127.0.0.1
APP_PORT=8000

# Sessão
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE=86400

# Imagens enviadas pelo admin (no container o volume monta em /app/uploads)
DIRETORIO_MIDIAS=uploads

# Regras de negócio (valores de demonstração)
FRETE_VALOR=8.00
FRETE_GRATIS_ACIMA=120.00
